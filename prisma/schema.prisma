// Схема базы данных для бота «Дрёмиус».
// Если нужно поменять структуру — правишь этот файл и запускаешь
// `npm run prisma:migrate` локально (создаст файл миграции),
// коммитишь и пушишь — на проде миграция применится сама при деплое
// (см. "start" в package.json: prisma migrate deploy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Все стадии, в которых может находиться пользователь.
// Заменяет числовой current_step из Google Sheets — тут понятные имена.
enum Stage {
  WELCOME // показано приветствие, ждём «Что я получу?»
  WELCOME_VALUE // не в основном пути с 27.10.2026: кнопки со старых сообщений
  STEPS // показаны три шага, ждём «Начать» / «Мой подход»
  HOW_IT_WORKS // показано "Как я работаю", ждём "Начать"
  TERMS // показаны условия (отдельным экраном, слит с экраном здоровья 15.10.2026)
  TERMS_HEALTH // показаны условия и блок про здоровье, ждём подтверждение
  DECLINE_REASON // не используется с 15.10.2026: вопрос о причине отказа убран
  HEALTH_SCREEN // показан экран про здоровье малыша, ждём подтверждение
  PD_CONSENT // показано согласие на обработку данных, ждём ответ
  MARKETING_CONSENT // показан вопрос про рассылку, ждём ответ
  QUESTION // идёт анкета, см. currentQuestionNumber
  SUMMARY_REVIEW // показана итоговая анкета, ждём «Подтвердить» / «Внести изменения»
  EDIT_PICK_QUESTION // ждём номер вопроса, который пользователь хочет изменить
  EDIT_ANSWER // переспрашиваем один вопрос, см. currentQuestionNumber
  EDIT_MORE // ждём ответ «менять ли что-то ещё»
  AWAITING_RECOMMENDATION // анкета подтверждена, ждём, пока admin пришлёт разбор
  FAKE_DOOR_OFFER // показан экран оплаты, ждём "Оплатить" / "Не сейчас"
  CONSULT_CONSENT // записался на консультацию, ждём, поделится ли контактом
  CSAT_RATING // ждём оценку 1-5
  CSAT_FEEDBACK // ждём открытый отзыв
  CSAT_DONE // всё завершено
  DECLINED // пользователь отказался проходить анкету
  OUT_OF_RANGE // возраст ребёнка вне диапазона 4-12 месяцев
  RED_FLAG_ENDED // анкета остановлена по красному флагу (вопрос 18)
}

enum SessionStatus {
  onboarding
  in_progress
  completed
  declined
  out_of_range
  red_flag_ended
}

enum RecommendationStatus {
  pending
  sent
  // Человек начал анкету заново, пока разбор ждал проверки. Разбор
  // остаётся в базе — он уже стоил денег и нужен для разбора спорных
  // случаев, — но не отправляется и не считается ожидающим.
  cancelled
}

model Session {
  id                  Int           @id @default(autoincrement())
  telegramId          BigInt        @unique
  chatId              BigInt
  firstName           String?
  stage               Stage         @default(WELCOME)
  status              SessionStatus @default(onboarding)
  currentQuestionNumber Float?      // заполнено, когда stage = QUESTION
  // Куда вернуть человека после согласий. Заполняется только у тех, кто
  // начал пользоваться ботом до того, как согласия появились: им экраны
  // показываются посреди сценария, и после ответа нужно вернуть их туда,
  // где они были.
  resumeStage         Stage?
  // Номер текущего прохождения анкеты. Растёт на единицу каждый раз,
  // когда человек начинает заново (/restart). Ответы и разборы прошлых
  // прохождений остаются в базе, но в новый разбор не попадают: читаем
  // только строки с этим номером (см. currentAttempt в engine.ts).
  attempt             Int           @default(1)
  // ── Поля для админки ──────────────────────────────────────────────
  // username Telegram без «@». Обновляется при каждом входе: человек
  // может его сменить, а админке нужен актуальный, чтобы открыть чат.
  // До 20.10.2026 username хранился только в заявке на консультацию.
  username            String?
  // Параметр deep-link из /start: откуда человек пришёл.
  source              String?
  // Ручные пометки админа. На поведение бота не влияют.
  tags                String[]      @default([])
  adminNote           String?
  // Когда Telegram впервые ответил 403 на отправку этому человеку.
  // Ставится трансформером API, см. src/blockedTracker.ts.
  botBlockedAt        DateTime?
  // Когда человек попросил удалить данные. Само удаление — отдельная
  // процедура, которой пока нет: порядок определит юрист.
  deletionRequestedAt DateTime?
  tempSelections      String[]      @default([]) // текущие выбранные варианты multi_choice (до "Готово")
  yellowFlags         String[]      @default([]) // накопленные жёлтые флаги для ручной проверки
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  answers         Answer[]
  // Разборов у человека столько, сколько прохождений анкеты: прошлые
  // остаются в базе и после перезапуска.
  recommendations Recommendation[]
  orders          Order[]
  consultRequests ConsultRequest[]
  upsellOffer     UpsellOffer?
  quizReminders   QuizReminder[]
  attempts        QuestionnaireAttempt[]

  @@index([status])
}

model Answer {
  id             Int      @id @default(autoincrement())
  telegramId     BigInt
  questionNumber Float // -3 = причина отказа, 30 = CSAT-оценка, 31 = CSAT-отзыв, 99 = доп. инфо после анкеты
  answerText     String
  // Прохождение, к которому относится ответ. Ответы прошлых
  // прохождений никуда не деваются, но в разбор идут только ответы
  // текущего — см. Session.attempt.
  attempt        Int      @default(1)
  createdAt      DateTime @default(now())

  session Session @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@index([telegramId])
  @@index([telegramId, attempt])
}

model Recommendation {
  id         Int                  @id @default(autoincrement())
  // Уникален не сам telegramId, а пара с прохождением: разборы прошлых
  // прохождений остаются в базе рядом с текущим.
  telegramId BigInt
  attempt    Int                  @default(1)
  // Что уйдёт или ушло родителю. Это и есть правимая версия.
  message1   String?
  message2   String?
  // Черновик модели, каким он пришёл из API. Не меняется никогда: по
  // ТЗ админки правки должны быть видны как diff, а для этого нужен
  // неизменный исходник. До 20.10.2026 его не было вовсе — правка
  // через /send затирала текст модели без следа.
  aiMessage1 String?
  aiMessage2 String?
  // Блок ВЫВОДЫ из первого вызова: по нему второй вызов пишет текст.
  // Храним, чтобы разбирать спорные разборы и не считать анализ заново.
  analysis   String?
  message3   String?
  message4   String?
  status     RecommendationStatus @default(pending)
  sentAt     DateTime?
  // Старт таймера ожидания: момент, с которого родитель ждёт разбор.
  // Отдельно от createdAt, потому что строка создаётся при завершении
  // анкеты, а таймер в будущем может стартовать и от другого события.
  waitStartedAt DateTime?
  // Текст ошибки Telegram, если разбор не дошёл. Таймер при этом не
  // останавливается: родитель всё ещё ждёт.
  deliveryError String?
  // Почему разбор отменён. Пока причина одна — человек начал заново, —
  // но текст хранится строкой: в админке он показывается как есть.
  cancelReason String?
  cancelledAt  DateTime?
  createdAt  DateTime             @default(now())

  session Session @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@unique([telegramId, attempt])
  @@index([telegramId])
}

// Каждое обращение к Claude API: токены, время и стоимость. Нужна, чтобы
// сравнивать модели и видеть реальную цену разбора (см. /cost в админке).
// Запись ведётся в try/catch — сбой логирования не должен ломать генерацию.
model ApiCall {
  id                  Int      @id @default(autoincrement())
  step                String // analysis | writer
  model               String
  sessionId           String // telegramId пользователя строкой
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int
  cacheReadTokens     Int
  durationMs          Int
  stopReason          String?
  costUsd             Float? // null, если модели нет в таблице цен
  createdAt           DateTime @default(now())

  @@index([createdAt])
}

// Платный продукт. Пока один, но enum — чтобы добавить следующий без миграции схемы кода.
enum Product {
  PDF
}

// PENDING_PAYMENT, PAID и REFUNDED заведены заранее: позже между «Купить» и
// генерацией встанет оплата, и добавлять значения enum уже не придётся.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  GENERATING
  DRAFT_READY
  SENT
  FAILED
  CANCELED
  REFUNDED
}

// Заказ платного разбора. Создаётся по кнопке «Купить».
model Order {
  id         Int         @id @default(autoincrement())
  telegramId BigInt
  // Прохождение, по разбору которого заказ куплен. Если человек потом
  // начнёт анкету заново, план всё равно соберётся по тому разбору,
  // который он читал, когда платил, — а не по новому.
  attempt    Int         @default(1)
  product    Product     @default(PDF)
  priceRub   Int // цена, показанная этому пользователю на кнопке
  status     OrderStatus @default(GENERATING)
  createdAt  DateTime    @default(now())
  sentAt     DateTime?
  canceledAt DateTime?
  failReason String? // почему FAILED: красный флаг или причина сбоя генерации

  // Под будущую оплату: пока не заполняются.
  yookassaPaymentId String?
  paidAt            DateTime?
  refundedAt        DateTime?
  // Чек самозанятого. Пока оплата не подключена, статус ставит админ
  // руками, и до подключения у большинства заказов он NOT_NEEDED.
  receiptStatus     ReceiptStatus @default(NOT_NEEDED)
  receiptUrl        String?
  // Ошибка Telegram при отправке готового файла. failReason выше — про
  // сбой генерации, это разные вещи: план может собраться и не дойти.
  deliveryError     String?

  session  Session      @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)
  draft    PdfDraft?
  feedback PdfFeedback?

  @@index([telegramId])
  @@index([status])
}

// Черновик PDF. aiContent — то, что выдала модель; после правок админа он
// НЕ перезаписывается, правки живут отдельно в editedContent. Перезаписать
// aiContent может только перегенерация.
model PdfDraft {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  aiContent     Json
  editedContent Json?
  rawPlan       String // полный ответ P1, как пришёл
  reviewerNotes String   @default("")
  planModel     String
  writerModel   String
  planTokensIn  Int      @default(0)
  planTokensOut Int      @default(0)
  writerTokensIn  Int    @default(0)
  writerTokensOut Int    @default(0)
  costUsd       Float?
  generationCount Int    @default(1)
  // Готовый PDF, чтобы отправить повторно и не рендерить заново.
  // Файл около мегабайта, заказов десятки в месяц — в базе это дешевле,
  // чем заводить и монтировать отдельное файловое хранилище.
  pdfBytes      Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  approvedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ── Согласия ────────────────────────────────────────────────────────
//
// Журнал, а не флажки: каждое действие пользователя — новая строка,
// строки никогда не меняются и не удаляются. Текущее состояние согласия
// — это последняя запись его типа. Так по любому пользователю можно
// показать всю историю: когда, на какую версию документа, каким текстом
// и какой кнопкой дано или отозвано согласие.

enum LegalDocType {
  PRIVACY_POLICY
  PD_CONSENT
  MARKETING_CONSENT
  OFFER
}

// Версия юридического документа. Текст лежит в репозитории, в
// legal/<тип>/<версия>.md, и его хэш записан здесь: по старой записи
// журнала всегда видно, какой именно текст человек видел.
model LegalDocument {
  id            Int          @id @default(autoincrement())
  type          LegalDocType
  version       String // например «draft-1» или «2026-10-14»
  url           String
  sha256        String // хэш файла с текстом документа
  effectiveFrom DateTime     @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([type, version])
  @@index([type, effectiveFrom])
}

enum ConsentType {
  PD_PROCESSING
  MARKETING
  OFFER_ACCEPTANCE
  SPECIALIST_TRANSFER
  // Родитель сам подтвердил, что у малыша нет особенностей здоровья,
  // влияющих на сон. Документа за этим подтверждением не стоит:
  // documentIds у таких записей пустой.
  HEALTH_SELF_DECLARATION
}

enum ConsentAction {
  GRANTED
  DECLINED
  REVOKED
}

enum ConsentSource {
  ONBOARDING
  PURCHASE_PDF
  CONSULT_SIGNUP
  UPSELL
  DATA_COMMAND
  UNSUBSCRIBE_COMMAND
  ADMIN
}

// Запись журнала. Только добавление: UPDATE и DELETE по этой таблице
// отклоняет триггер в базе (см. миграцию), а в коде есть только create.
//
// Внешнего ключа на Session намеренно нет: журнал должен пережить
// удаление данных пользователя, а каскад унёс бы его вместе с сессией.
model ConsentRecord {
  id         Int           @id @default(autoincrement())
  telegramId BigInt
  type       ConsentType
  action     ConsentAction
  source     ConsentSource
  // Документы, показанные в момент действия: для ПД это и политика, и
  // само согласие, поэтому список, а не одна ссылка.
  documentIds Int[]        @default([])
  // Точный текст, который видел человек, и кнопка, которую он нажал.
  messageText       String
  buttonText        String
  telegramMessageId Int?
  relatedOrderId          Int?
  relatedConsultRequestId Int?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  @@index([telegramId, type, createdAt])
  @@index([type, action])
}

// Исходящее сообщение, которое бот не отправил из-за отсутствия
// согласия. Нужна, чтобы было видно: человек не получил предложение не
// по ошибке, а потому что отказался от рассылки.
//
// Хранит ровно столько, сколько нужно для этого ответа: кому, какой
// категории и какого рода было сообщение.
model SuppressedMessage {
  id         Int      @id @default(autoincrement())
  telegramId BigInt
  category   String // SERVICE | FEEDBACK | FOLLOWUP | MARKETING
  kind       String // что именно не ушло, например upsell_offer
  createdAt  DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

// ── Обратная связь ──────────────────────────────────────────────────
//
// Два отложенных вопроса: «узнали в разборе своего малыша?» через сутки
// после бесплатного разбора и «как сейчас сон малыша?» через неделю
// после плана. Оба живут по одним правилам — окно 10:00–21:00 по Москве
// и не больше одного вопроса за сутки, — поэтому и устроены одинаково.
//
// Строка создаётся в момент, когда вопрос запланирован, и дальше её
// двигает планировщик. askedAt заполняется при отправке, skipReason —
// когда отправлять не стали.

enum AnalysisRating {
  YES
  PARTLY
  NO
}

model AnalysisFeedback {
  id         Int             @id @default(autoincrement())
  telegramId BigInt          @unique
  scheduledAt DateTime
  askedAt    DateTime?
  rating     AnalysisRating?
  comment    String?
  skippedComment Boolean     @default(false)
  answeredAt DateTime?
  // Сообщение с просьбой о комментарии: по нему убираем кнопку
  // «Пропустить», когда комментарий всё-таки пришёл.
  promptMessageId Int?
  skipReason String?
  // Вопрос уже переносили из-за лимита одного вопроса в сутки. Второй
  // раз не переносим: тогда спрашивать уже поздно.
  limitDeferred Boolean      @default(false)
  createdAt  DateTime        @default(now())

  @@index([askedAt])
  @@index([scheduledAt])
}

enum PdfResult {
  BETTER
  SAME
  WORSE
  NOT_STARTED
}

model PdfFeedback {
  id         Int        @id @default(autoincrement())
  orderId    Int        @unique
  telegramId BigInt
  scheduledAt DateTime
  askedAt    DateTime?
  result     PdfResult?
  comment    String?
  skippedComment Boolean @default(false)
  answeredAt DateTime?
  // Сообщение с просьбой о комментарии: по нему убираем кнопку
  // «Пропустить», когда комментарий всё-таки пришёл.
  promptMessageId Int?
  skipReason String?
  limitDeferred Boolean  @default(false)
  createdAt  DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([telegramId])
  @@index([askedAt])
  @@index([scheduledAt])
}

// ── Поддержка ───────────────────────────────────────────────────────
//
// Отдельный бот, та же база. На каждого родителя — своя тема в закрытой
// группе; что написал он и что ответила поддержка, копируется сюда.
//
// Переписка — свободный текст, в ней может быть что угодно, в том числе
// о здоровье. Обращаемся с ней как со свободным ответом анкеты: в модель
// не передаём, меток по содержанию не ставим, при отзыве согласия
// удаляем вместе с остальными данными человека.

enum SupportStatus {
  WAITING // последним написал родитель, ждёт ответа
  ANSWERED // последней ответила поддержка
  CLOSED // обращение закрыто
}

enum SupportDirection {
  IN // от родителя
  OUT // ответ поддержки
  NOTE // внутренняя заметка, родителю не ушла
}

model SupportThread {
  id         Int           @id @default(autoincrement())
  telegramId BigInt        @unique
  // Тема в группе. Пустая, пока группа не привязана: сообщения в это
  // время копятся и переезжают в тему при привязке.
  topicId    Int?
  status     SupportStatus @default(WAITING)
  // Параметр из /start, если родитель пришёл по ссылке с меткой.
  source     String?
  createdAt  DateTime      @default(now())
  lastUserMessageAt    DateTime?
  lastSupportMessageAt DateTime?
  closedAt   DateTime?

  messages SupportMessage[]

  @@index([status])
}

model SupportMessage {
  id              Int              @id @default(autoincrement())
  threadId        Int
  direction       SupportDirection
  authorTelegramId BigInt
  type            String // text | photo | voice | document | ...
  text            String? // текст или подпись
  fileId          String? // сам файл не скачиваем, храним ссылку Telegram
  userMessageId   Int? // id сообщения в чате с родителем
  groupMessageId  Int? // id сообщения в теме группы
  deliveryError   String?
  createdAt       DateTime         @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// Мелкие настройки, которые задаются в работе, а не переменными
// окружения: сейчас это id группы поддержки, привязанной командой /bind.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Обезличенный счётчик по дням.
//
// Нужен там, где считать можно, а знать кто — нельзя: например, сколько
// родителей ушло с экрана здоровья. Ни telegram id, ни связи с сессией
// здесь нет намеренно — по этой таблице нельзя восстановить, кто именно
// нажал кнопку, а это и есть причина, по которой такие данные вообще
// разрешено хранить.
model DailyCounter {
  id    Int      @id @default(autoincrement())
  name  String // например health_screen_exit
  day   DateTime @db.Date
  count Int      @default(0)

  @@unique([name, day])
}

// Воронка оффера: показ экрана выбора, открытие карточек, возврат
// назад, клик по примеру, покупка плана, запись на консультацию, отказ.
enum OfferEventType {
  offer_shown
  example_clicked
  buy_clicked
  offer_pdf_details
  offer_consult_details
  offer_back
  consult_signup
  offer_declined
  upsell_shown
  upsell_details
  upsell_signup
  upsell_declined
  upsell_expired_click
  // Воронка онбординга: по одному событию на экран, один раз на
  // человека. В /stats считается по уникальным людям, поэтому повторные
  // проходы воронку не раздувают.
  onb_welcome
  onb_welcome_value
  onb_steps
  onb_how_it_works
  onb_terms
  onb_health
  onb_pd_consent
  onb_marketing
  onb_go
  // quiz_q1 не пишется с 20.10.2026: его заменил quiz_question_shown с
  // номером 1. Тип оставлен ради записей, сделанных раньше.
  quiz_q1
  quiz_completed
  guide_sent
  // Вопросы обратной связи: оценка разбора через сутки и результат
  // плана через неделю. По ним собирается статистика во втором заходе.
  csat_asked
  analysis_feedback_scheduled
  analysis_feedback_asked
  analysis_feedback_skipped
  analysis_feedback_rated
  analysis_feedback_comment
  analysis_feedback_comment_skipped
  pdf_feedback_scheduled
  pdf_feedback_asked
  pdf_feedback_skipped
  pdf_feedback_answered
  pdf_feedback_comment
  pdf_feedback_comment_skipped
  // Меню бота. В отличие от воронки онбординга эти события пишутся
  // каждый раз, а не раз на человека: в /stats интересно, сколько раз
  // меню открывали, а не сколько людей его хоть раз видели.
  menu_opened
  menu_support
  menu_docs
  menu_team
  restart_asked
  restart_confirmed
  // Возврат через /start, когда анкета уже пройдена: новое
  // прохождение заводится молча, подтверждать нечего.
  start_new_attempt
  // Подтверждение с отменой ждавшего разбора. Отдельным событием, а не
  // полем: п.8 ТЗ просит видеть, сколько перезапусков обнулили разбор.
  restart_confirmed_cancelled_draft
  restart_cancelled
  // Напоминания о незаконченной анкете. Номер напоминания в самом типе:
  // у OfferEvent нет колонки для данных, а различать их нужно. Номер
  // вопроса, на котором человек встал, лежит в QuizReminder.
  quiz_reminder_1_sent
  quiz_reminder_2_sent
  quiz_reminder_continue_click
  quiz_reminder_cancelled
  quiz_resumed_after_reminder_1
  quiz_resumed_after_reminder_2
  quiz_completed_after_reminder

  // ── Полная разметка воронки (20.10.2026) ──────────────────────────
  //
  // С этого момента событие пишется каждый раз, когда шаг происходит:
  // дедупликации «раз на человека» больше нет, уникальных людей считаем
  // в SQL через DISTINCT. Исключение — guide_sent: гайд и по продукту
  // отправляется один раз.

  // Онбординг: ответы на экранах, а не только их показы.
  onb_health_ok
  onb_pd_granted
  onb_pd_declined
  onb_marketing_yes
  onb_marketing_no

  // Анкета. questionNumber обязателен.
  quiz_question_shown
  quiz_question_answered
  quiz_answer_invalid
  quiz_out_of_range

  // Сверка и правка ответов.
  quiz_summary_shown
  quiz_edit_started
  quiz_edit_question_shown
  quiz_edit_invalid_pick
  quiz_edit_answered
  quiz_edit_more
  quiz_edit_done

  // После анкеты.
  quiz_addendum_received
  analysis_draft_created
  analysis_sent
  analysis_send_failed

  // Покупка плана.
  buy_repeat_click
  order_generation_started
  order_generation_failed
  pdf_sent

  // Апселл.
  upsell_back
  upsell_skipped

  // Заявка на консультацию.
  consult_contact_shared
  consult_self_contact
  consult_wrong_contact
  consult_signup_duplicate
  consult_sent_to_specialist

  // CSAT: сама оценка и текст остаются в ответах 30 и 31.
  csat_rated
  csat_feedback_left

  // Меню.
  menu_back_to_quiz

  // Данные и согласия.
  data_opened
  marketing_unsubscribed
  marketing_subscribed
  pd_revoke_asked
  pd_revoked
  pd_revoke_cancelled
  message_suppressed

  // Бот поддержки. У этих событий attempt = 0, если сессии нет.
  support_started
  support_ask_clicked
  support_thread_opened
  support_message_in
  support_reply_out
  support_unsupported_type

  // Служебное.
  closed_mode_blocked
  unrecognized_input
  consent_write_failed
  bot_blocked
}

// Журнал событий: по нему строится воронка родителя от /start до покупки
// (см. analytics/funnel.sql).
//
// Связи с Session здесь намеренно нет, хотя telegramId тот же. Причины
// две. Первая: события пишет и бот поддержки, а туда приходят люди,
// которых в основном боте нет вовсе, — внешний ключ ломал бы вставку.
// Вторая: журнал аналитики не должен исчезать вместе с сессией, иначе
// любой /reset переписывал бы историю.
//
// Плата за это — события не удаляются каскадом. Когда появится
// процедура удаления данных по отзыву согласия, снести их нужно явно:
// см. пометку в src/dataCommand.ts.
model OfferEvent {
  id         Int            @id @default(autoincrement())
  telegramId BigInt
  type       OfferEventType
  // Номер вопроса анкеты у событий анкеты, правки ответов и
  // напоминаний; у остальных NULL. Тип и кодировка те же, что у
  // Session.currentQuestionNumber: вопросы целые, кроме условного 4.5
  // («своими словами»), который так и хранится как 4.5.
  questionNumber Float?
  // Номер прохождения анкеты на момент события. У записей, сделанных до
  // появления этой колонки, NULL: по старым данным прохождения честно
  // не различить. Ноль — событие человека, у которого сессии нет
  // (пришёл только в бот поддержки).
  attempt    Int?
  createdAt  DateTime       @default(now())

  @@index([telegramId])
  @@index([type])
  @@index([telegramId, attempt, createdAt])
  @@index([type, createdAt])
}

// PENDING_PAYMENT и PAID заведены заранее, как у заказа PDF: позже между
// кнопкой «Записаться» и отправкой заявки специалисту встанет оплата.
enum ConsultStatus {
  PENDING_PAYMENT
  PAID
  NEW
  CONTACTED
  DONE
  CANCELED
}

// Кто пишет первым. PENDING — родитель ещё не выбрал, и до его выбора
// заявка специалисту не уходит: передавать контакт без разрешения нельзя.
enum FirstContact {
  PENDING
  SPECIALIST
  PARENT
}

// Откуда пришла заявка: из основного оффера после бесплатного разбора
// или из предложения со скидкой, которое уходит после покупки плана.
enum ConsultSource {
  OFFER
  AFTER_PDF
}

// Заявка на консультацию специалиста. Создаётся по кнопке «Записаться».
model ConsultRequest {
  id               Int           @id @default(autoincrement())
  telegramId       BigInt
  // Прохождение, по которому записались: пакет специалисту собирается
  // из той анкеты и того разбора, что человек читал при записи, даже
  // если он успел начать заново.
  attempt          Int           @default(1)
  priceRub         Int // цена, показанная этому родителю на кнопке
  status           ConsultStatus @default(NEW)
  parentUsername   String? // без «@»; у аккаунта может не быть username
  parentPhone      String? // только если родитель сам поделился контактом
  contactConsentAt DateTime? // когда родитель разрешил передать контакт
  firstContact     FirstContact  @default(PENDING)
  source           ConsultSource @default(OFFER)
  // Заказ плана, после которого пришло предложение со скидкой. Есть
  // только у заявок с source = AFTER_PDF: по нему специалисту уходит
  // тот же PDF, что получил родитель.
  orderId          Int?
  createdAt        DateTime      @default(now())
  contactedAt      DateTime?
  doneAt           DateTime?
  canceledAt       DateTime?

  // Под будущую оплату: пока не заполняются.
  yookassaPaymentId String?
  paidAt            DateTime?
  refundedAt        DateTime?
  // Дневник сна за 3–5 дней: без него София не начинает разбор.
  diaryReceived     Boolean       @default(false)
  // Доля Софии. Заполняется вручную при отметке выплаты: процент пока
  // не решён, и считать автоматически нечего.
  consultantPayoutRub Int?
  payoutPaidAt        DateTime?
  note                String?

  session Session      @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)
  upsell  UpsellOffer?

  @@index([telegramId])
  @@index([status])
}

// Предложение консультации со скидкой после покупки плана. Отдельная
// таблица, а не поле у заказа: предложение одно на родителя, даже если
// планов он купил несколько, и у него своя жизнь — срок и отказ.
model UpsellOffer {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt   @unique
  orderId      Int // заказ плана, после которого ушло предложение
  priceRub     Int // цена со скидкой, показанная этому родителю
  fullPriceRub Int // обычная цена на момент отправки — для сравнения в тексте
  sentAt       DateTime @default(now())
  expiresAt    DateTime // конец дня по Москве, см. src/upsell.ts
  // Сообщение с предложением: по нему его можно будет найти и поправить
  // не только из обработчика нажатия.
  messageId    Int?
  declinedAt   DateTime?
  // Почему предложение не ушло: родитель остановил бота, закрытый
  // режим и т.п. Повторять такое не нужно.
  skipReason   String?
  // Заявка, если родитель всё-таки записался по этому предложению.
  consultRequestId Int? @unique

  session Session         @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)
  consult ConsultRequest? @relation(fields: [consultRequestId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

// Напоминания о незаконченной анкете: через 3 часа и через 24 часа
// после последнего ответа (см. src/quizReminders.ts).
//
// Одна строка на прохождение анкеты, а не на человека: начав заново, он
// получает право на новые два напоминания, а прошлая строка остаётся —
// по ней в /stats видно, на каких вопросах люди останавливаются.
//
// Строка появляется в момент показа первого вопроса и живёт до конца
// анкеты. Если напоминания остановлены (анкета пройдена, согласие
// отозвано, человек заблокировал бота), причина пишется в
// remindersStoppedReason, и планировщик строку больше не берёт.
model QuizReminder {
  id         Int    @id @default(autoincrement())
  telegramId BigInt
  attempt    Int    @default(1)

  // Последний ответ на вопрос анкеты. От него считается срок обоих
  // напоминаний; открытие меню или документов активностью не считается.
  lastActivityAt DateTime @default(now())

  reminder1ScheduledAt DateTime?
  reminder1SentAt      DateTime?
  // На каком вопросе человек стоял, когда ушло первое напоминание.
  // Здесь, а не в событии: у OfferEvent нет колонки для данных, а топ-5
  // «где застревают» в /stats строится именно по этому числу.
  reminder1QuestionNumber Float?

  reminder2ScheduledAt DateTime?
  reminder2SentAt      DateTime?
  // Человек ответил хотя бы на один вопрос после первого напоминания:
  // второе отменяется насовсем, даже если он снова остановится.
  reminder2Cancelled   Boolean  @default(false)

  remindersStoppedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@unique([telegramId, attempt])
  @@index([reminder1ScheduledAt])
  @@index([reminder2ScheduledAt])
}

// Чек самозанятого по оплаченному заказу.
enum ReceiptStatus {
  NOT_NEEDED // оплата не подключена или заказ не оплачен
  PENDING // оплачен, чек ещё не выбит
  ISSUED // чек выбит, ссылка в receiptUrl
}

// Состояние прохождения анкеты.
//
// ABANDONED здесь нет намеренно: «нет активности 48 часов» — это не
// событие, а наблюдение в момент просмотра. Хранить такой статус
// значит держать фоновую задачу, которая его проставляет, и жить с
// тем, что между её тиками статус врёт. Админка считает заброшенность
// из lastActivityAt при каждом запросе (см. src/web/attempts.ts).
enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

// Одно прохождение анкеты.
//
// До 20.10.2026 прохождение было просто числом в Session.attempt, и по
// нему нельзя было узнать ни когда человек начал, ни где остановился.
// Теперь на каждое прохождение есть строка, которая завод��тся при
// показе первого вопроса и закрывается при подтверждении анкеты.
//
// У прохождений, существовавших до миграции, startedAt и lastStep
// восстановлены приблизительно: точных данных по ним в базе нет.
model QuestionnaireAttempt {
  id            Int           @id @default(autoincrement())
  telegramId    BigInt
  attemptNumber Int
  // Версия анкеты на момент прохождения: вопросы со временем меняются,
  // и без версии старые ответы нельзя честно сравнивать с новыми.
  questionnaireVersion String
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  // Номер вопроса, на котором человек стоит или остановился. Тот же
  // формат, что у Session.currentQuestionNumber: условный вопрос 4.5
  // так и хранится.
  lastStep      Float?
  lastActivityAt DateTime     @default(now())
  status        AttemptStatus @default(IN_PROGRESS)

  session Session @relation(fields: [telegramId], references: [telegramId], onDelete: Cascade)

  @@unique([telegramId, attemptNumber])
  @@index([status, lastActivityAt])
}

// Журнал действий админа. Нужен затем, чтобы через месяц можно было
// понять, кто поменял текст разбора или перевёл заказ в оплаченные.
//
// adminId — telegram id админа: отдельной таблицы администраторов нет,
// их пока один, и логин хранится в переменных окружения.
model AdminAction {
  id         Int      @id @default(autoincrement())
  adminId    BigInt
  action     String // краткий код: draft_edited, order_marked_paid, …
  entityType String // recommendation, order, consult, session
  entityId   String // id записи строкой: ключи у таблиц разных типов
  // Что именно изменилось. Для правки текста — старое и новое значение,
  // для смены статуса — оба статуса.
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminId])
}
