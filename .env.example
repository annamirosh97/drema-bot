# Скопируй этот файл в .env и заполни своими значениями.
# .env в Git не попадает (см. .gitignore) — секреты туда не утекут.

# Токен бота, который выдаёт @BotFather в Telegram
BOT_TOKEN=

# Строка подключения к Postgres. Локально — свой Postgres или Docker,
# на Railway — Railway сам подставит эту переменную, если подключить
# плагин Postgres к сервису (см. README.md).
DATABASE_URL=postgresql://user:password@localhost:5432/drema

# Твой Telegram ID (числом). Узнать — написать боту @userinfobot.
# Только с этого ID будут работать /pending, /prep, /send, /approve, /stats.
# Сюда же бот присылает черновики разборов на проверку.
ADMIN_TELEGRAM_ID=

# Ключ к Claude API — им бот сам готовит черновик разбора сразу после
# анкеты. Взять в console.anthropic.com → API keys. Начинается с sk-ant-
ANTHROPIC_API_KEY=

# Модели для двух шагов генерации разбора. Можно не задавать — тогда
# обе будут claude-opus-5. Задаются отдельно, чтобы сравнивать качество
# и цену по шагам: например, анализ на opus, письмо на sonnet.
# Доступные: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
ANALYSIS_MODEL=claude-opus-5
WRITER_MODEL=claude-opus-5

# Цена платного PDF, в рублях. Если не задать — будет 990.
PDF_PRICE_RUB=990

# Цена консультации специалиста, в рублях. Если не задать — будет 4990.
CONSULT_PRICE_RUB=4990

# Telegram-username специалиста, который проводит консультации, без «@».
# Подставляется в сообщения родителю: по нему он находит специалиста.
SPECIALIST_USERNAME=sophiazolotova

# Telegram ID специалиста (числом). Необязательно: если задан, пакет
# заявки уходит не только админу, но и ей. Писать ей бот сможет только
# после того, как она хотя бы раз нажмёт /start — ограничение Telegram.
CONSULT_SPECIALIST_TELEGRAM_ID=

# Предложение консультации со скидкой тем, кто купил план: цена в рублях,
# сколько дней оно действует (срок — конец дня по Москве) и через сколько
# минут после отправки PDF приходит. По умолчанию 3990, 7 и 2.
UPSELL_PRICE_RUB=3990
UPSELL_VALID_DAYS=7
UPSELL_DELAY_MIN=2

# Модели двух шагов генерации платного PDF: план и текст.
# Можно не задавать — тогда обе будут claude-opus-5.
PDF_PLAN_MODEL=claude-opus-5
PDF_WRITER_MODEL=claude-opus-5

# Пароль к веб-админке, где проверяются черновики PDF. Логин любой.
# Если не задать — админка не поднимется, бот при этом работает.
# Вход в админку. Хэш пароля получить командой: npm run admin:hash
# Секрет подписи сессий — случайная строка, например openssl rand -hex 32
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Локально поставить false, иначе cookie не доедет по http.
ADMIN_HTTPS_ONLY=true

# Пороги таймеров ожидания в админке, в часах: обещание, жёлтый, красный.
SLA_PROMISE_HOURS=24
SLA_WARN_HOURS=12
SLA_DANGER_HOURS=20

# Прежний пароль basic auth. Нужен только на время переезда на вход по
# логину: когда ADMIN_LOGIN и ADMIN_PASSWORD_HASH заданы, не используется.
ADMIN_PASSWORD=

# Публичный адрес приложения, без слеша на конце. На Railway его выдаёт
# Settings → Networking → Generate Domain. Из него собираются ссылки на
# заказы, которые бот присылает в Telegram.
PUBLIC_BASE_URL=https://drema-bot-production.up.railway.app

# Порт веб-админки. На Railway подставляется автоматически, локально
# можно не задавать — будет 3000.
PORT=3000

# Почта для связи на финальной странице PDF. Если не задать, строка не
# выводится. ФИО, ИНН и телефон в PDF не выводятся принципиально.
CONTACT_EMAIL=

# Адреса юридических документов. Можно не задавать: тогда они соберутся
# из PUBLIC_BASE_URL и будут вести на страницы-заглушки самого бота
# (/privacy, /consent, /marketing-consent, /offer). Когда юрист пришлёт
# финальные тексты и они лягут где-то ещё, пропиши адреса сюда.
PRIVACY_POLICY_URL=
PD_CONSENT_URL=
MARKETING_CONSENT_URL=
OFFER_URL=

# Требовать ли согласие на рассылку для опроса о впечатлениях (CSAT).
# По умолчанию нет: это не реклама, а вопрос о качестве услуги, за
# которой человек пришёл сам. Поставь true, если решим иначе.
FEEDBACK_REQUIRES_MARKETING=false

# Отложенные вопросы обратной связи: через сколько часов после разбора
# спросить «узнали своего малыша?» и через сколько дней после плана —
# «как сейчас сон?». Окно отправки задаётся часами по Москве: вне его
# вопрос переносится на ближайшее начало окна.
FREE_ANALYSIS_FEEDBACK_DELAY_HOURS=24
PDF_FEEDBACK_DELAY_DAYS=7
# Окно, в которое бот отправляет сообщения по своей инициативе: и
# отложенные вопросы, и напоминания о незаконченной анкете. По Москве.
# Старые имена FEEDBACK_WINDOW_START/END ещё читаются как запасные.
REMINDER_WINDOW_START=10
REMINDER_WINDOW_END=21

# Через сколько часов после последнего ответа напоминать о незаконченной
# анкете. Второе напоминание уходит, только если после первого человек
# так и не ответил.
QUIZ_REMINDER_1_HOURS=3
QUIZ_REMINDER_2_HOURS=24

# Бот поддержки. Токен берётся у @BotFather, как и для основного бота.
# Если не задан, бот поддержки не запускается, основной работает как
# обычно. SUPPORT_ADMIN_IDS — через запятую, кто может привязать группу
# командой /bind и отвечать родителям; по умолчанию ADMIN_TELEGRAM_ID.
# Username основного бота без «@». На него ссылается приветствие бота
# поддержки: туда часто приходят, разыскивая основной бот.
MAIN_BOT_USERNAME=drema_sleep_bot

# Закрытый режим. Пусто — бот открыт для всех. Если перечислить id через
# запятую, всем остальным бот ответит, что скоро откроется, и ничего про
# них не сохранит. ADMIN_TELEGRAM_ID добавляется в список сам.
ALLOWED_USER_IDS=

# Свои аккаунты через запятую: их прохождения исключаются из запросов
# воронки. На запись событий не влияет.
INTERNAL_TELEGRAM_IDS=

SUPPORT_BOT_TOKEN=
SUPPORT_ADMIN_IDS=

# Username бота поддержки без «@». Из него собирается кнопка «Написать в
# поддержку» в меню (/menu → Поддержка). Если не задан, вместо кнопки
# показывается CONTACT_EMAIL.
SUPPORT_BOT_USERNAME=
