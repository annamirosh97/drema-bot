# Скопируй этот файл в .env и заполни своими значениями.
# .env в Git не попадает (см. .gitignore) — секреты туда не утекут.

# Токен бота, который выдаёт @BotFather в Telegram
BOT_TOKEN=

# Строка подключения к Postgres. Локально — свой Postgres или Docker,
# на Railway — Railway сам подставит эту переменную, если подключить
# плагин Postgres к сервису (см. README.md).
DATABASE_URL=postgresql://user:password@localhost:5432/drema

# Твой Telegram ID (числом). Узнать — написать боту @userinfobot.
# Только с этого ID будут работать /pending, /prep, /send, /approve, /stats.
# Сюда же бот присылает черновики разборов на проверку.
ADMIN_TELEGRAM_ID=

# Ключ к Claude API — им бот сам готовит черновик разбора сразу после
# анкеты. Взять в console.anthropic.com → API keys. Начинается с sk-ant-
ANTHROPIC_API_KEY=

# Модели для двух шагов генерации разбора. Можно не задавать — тогда
# обе будут claude-opus-5. Задаются отдельно, чтобы сравнивать качество
# и цену по шагам: например, анализ на opus, письмо на sonnet.
# Доступные: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
ANALYSIS_MODEL=claude-opus-5
WRITER_MODEL=claude-opus-5

# Цена платного PDF, в рублях. Если не задать — будет 990.
PDF_PRICE_RUB=990

# Модели двух шагов генерации платного PDF: план и текст.
# Можно не задавать — тогда обе будут claude-opus-5.
PDF_PLAN_MODEL=claude-opus-5
PDF_WRITER_MODEL=claude-opus-5

# Пароль к веб-админке, где проверяются черновики PDF. Логин любой.
# Если не задать — админка не поднимется, бот при этом работает.
ADMIN_PASSWORD=

# Публичный адрес приложения, без слеша на конце. На Railway его выдаёт
# Settings → Networking → Generate Domain. Из него собираются ссылки на
# заказы, которые бот присылает в Telegram.
PUBLIC_BASE_URL=https://drema-bot-production.up.railway.app

# Порт веб-админки. На Railway подставляется автоматически, локально
# можно не задавать — будет 3000.
PORT=3000

# Контакты на финальной странице PDF. Если не задать, строки не выводятся.
# ФИО, ИНН и телефон в PDF не выводятся принципиально.
OFFER_URL=
CONTACT_EMAIL=
